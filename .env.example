# Postgres (+ pgvector)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/unichatbot

# Redis (BullMQ)
REDIS_URL=redis://localhost:6380

# Ollama (embeddings: bge-m3, generation: qwen2.5)
OLLAMA_URL=http://localhost:11434
OLLAMA_EMBED_MODEL=bge-m3
OLLAMA_GENERATE_MODEL=qwen2.5:7b

# Claude API (alternative generation provider, chosen per tenant via llm_provider)
ANTHROPIC_API_KEY=

# Gemini API (alternative generation provider, chosen per tenant via llm_provider)
GEMINI_API_KEY=
GEMINI_GENERATE_MODEL=gemini-flash-latest

# API
API_PORT=3000

# Extractor (child_process path for MVP; PYTHON_BIN must have requirements.txt installed)
PYTHON_BIN=python3

# PDFs at or under this size auto-process during a crawl; larger ones (or
# unknown size) wait for admin approval. Per-tenant crawl_configs row can
# override this default.
PDF_SIZE_THRESHOLD_BYTES=2097152

# Admin dashboard (Auth.js). Generate AUTH_SECRET with: npx auth secret
AUTH_SECRET=
AUTH_URL=http://localhost:3001
