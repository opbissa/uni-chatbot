{"pages": [{"n": 1, "text": "ys MAHARAJA GANGA SINGH UNIVERSITY,BIKANER\nFORMERLY UNIVERSITY OF BIKANER, BIKANER\n\n\u0930\u093e\u0937\u094d\u091f\u094d\u0930\u0940\u092f \u0930\u093e\u091c\u092e\u093e\u0930\u094d\u0917 \u0938\u0902. 45, \u091c\u0948\u0938\u0932\u092e\u0947\u0930 \u0930\u094b\u0921\u093c, \u092c\u0940\u0915\u093e\u0928\u0947\u0930-334004 (\u0930\u093e\u091c\u0938\u094d\u0925\u093e\u0928) \u092d\u093e\u0930\u0924\n\nNATIONAL HIGHWAY NO. 5, JAISALMER ROAD, BIKANER-334004 (RAJASTHAN) INDIA\n\nas /Phone : 05-222044 baa/Fax : 22[2042 g-4e/E-mail : mgsubikaner@gmail.com _\n\n\u0915\u094d\u0930\u092e\u093e\u0902\u0915 : \u092a.45 ( )/\u092e\u0917\u0938\u093f\u0902\u0935\u093f\u092c\u0940/ We / 2026 / 255\u096b \u096f \u0926\u093f\u0928\u093e\u0902\u0915 A4-Of-202L\n\n\u0915\u093e\u0930\u094d\u092f\u093e\u0932\u092f \u0906\u0926\u0947\u0936\n\n\u092e\u093e\u0928\u0928\u0940\u092f \u0915\u0941\u0932\u0917\u0941\u0930\u0942 \u092e\u0939\u094b\u0926\u092f \u0926\u094d\u0935\u093e\u0930\u093e \u092a\u094d\u0930\u0926\u0924\u094d\u0924 \u0938\u094d\u0935\u0940\u0915\u0943\u0924\u093f \u0926\u093f\u0928\u093e\u0902\u0915 24.07.2026 \u0915\u0940 \u092a\u093e\u0932\u0928\u093e \u092e\u0947\u0902 \u0935\u093f\u0936\u094d\u0935\u0935\u093f\u0926\u094d\u092f\u093e\u0932\u092f \u0915\u0947\n\u0935\u093f\u092d\u093e\u0917\u094b\u0902 \u090f\u0935\u0902 \u0938\u0902\u092c\u0902\u0926\u094d\u0927\u0924\u093e \u092a\u094d\u0930\u093e\u092a\u094d\u0924 \u092e\u0939\u093e\u0935\u093f\u0926\u094d\u092f\u093e\u0932\u092f\u094b\u0902 \u092e\u0947\u0902 \u0938\u0902\u091a\u093e\u0932\u093f\u0924 \u0938\u094d\u0928\u093e\u0924\u0915 /\u0938\u094d\u0928\u093e\u0924\u0915\u094b\u0924\u094d\u0924\u0930 \u0938\u092e \u0938\u0947\u092e\u0947\u0938\u094d\u091f\u0930 \u091c\u0942\u0928 2026 \u0915\u0947 \u0932\u093f\u090f\n\u0906\u0935\u0947\u0926\u0928 \u092a\u0924\u094d\u0930 \u092d\u0930\u0928\u0947 \u0938\u0947 \u0935\u0902\u091a\u093f\u0924 \u0930\u0939\u0947 \u0935\u093f\u0926\u094d\u092f\u093e\u0930\u094d\u0925\u093f\u092f\u094b\u0902 \u0915\u094b \u0909\u0928\u0915\u0947 \u0905\u0928\u0941\u0930\u094b\u0927 \u0915\u0947 \u0906\u0927\u093e\u0930 \u092a\u0930 \u0924\u0940\u0928 \u0917\u0941\u0923\u093e \u0936\u0941\u0932\u094d\u0915 \u0915\u0947 \u0938\u093e\u0925 \u0906\u091c\n\u0926\u093f\u0928\u093e\u0902\u0915 24.07.2026 \u0915\u094b \u0905\u0902\u0924\u093f\u092e \u0905\u0935\u0938\u0930 \u092a\u094d\u0930\u0926\u093e\u0928 \u0915\u093f\u092f\u093e \u091c\u093e\u0924\u093e \u0939\u0948\u0964 \u0911\u0928\u0932\u093e\u0908\u0928 \u092a\u0930\u0940\u0915\u094d\u0937\u093e \u0906\u0935\u0947\u0926\u0928 \u092a\u0924\u094d\u0930 \u092d\u0930\u0928\u0947 \u0938\u092e\u094d\u092c\u0928\u094d\u0927\u0940 \u0926\u093f\u0936\u093e\n\u0928\u093f\u0930\u094d\u0926\u0947\u0936 \u0935\u093f\u0936\u094d\u0935\u0935\u093f\u0926\u094d\u092f\u093e\u0932\u092f \u0935\u0947\u092c\u0938\u093e\u0907\u091f \u092a\u0930 \u0909\u092a\u0932\u092c\u094d\u0927 \u0939\u0948\u0964\n\npyre\n(\u092a\u094d\u0930\u094b. \u0930\u093e\u091c\u093e\u0930\u093e\u092e \u091a\u094b\u092f\u0932)\n\u092a\u0930\u0940\u0915\u094d\u0937\u093e \u0928\u093f\u092f\u0902\u0924\u094d\u0930\u0915\n\n\u0915\u094d\u0930\u092e\u093e\u0902\u0915 : 045 ( ),/\u092e\u0917\u0938\u093f\u0902\u0935\u093f\u092c\u0940 / \u092a\u0930\u0940\u0915\u094d\u0937\u093e / 2026 / \u0926\u093f\u0928\u093e\u0902\u0915 :\n\u092a\u094d\u0930\u0924\u093f\u0932\u093f\u092a\u093f:- \u0928\u093f\u092e\u094d\u0928 \u0915\u094b \u0938\u0942\u091a\u0928\u093e\u0930\u094d\u0925 \u090f\u0935\u0902 \u0906\u0935\u0936\u094d\u092f\u0915 \u0915\u093e\u0930\u094d\u092f\u0935\u0939\u0940 \u0939\u0947\u0924\u0941 \u092a\u094d\u0930\u0947\u0937\u093f\u0924 \u0939\u0948\u0903-\n\n4. \u0928\u093f\u091c\u0940 \u0938\u091a\u093f\u0935 \u0915\u0941\u0932\u0917\u0941\u0930\u0942, \u092e\u0939\u093e\u0930\u093e\u091c\u093e \u0917\u0902\u0917\u093e\u0938\u093f\u0902\u0939 \u0935\u093f\u0936\u094d\u0935\u0935\u093f\u0926\u094d\u092f\u093e\u0932\u092f, \u092c\u0940\u0915\u093e\u0928\u0947\u0930 |\n\u0928\u093f\u091c\u0940 \u0938\u0939\u093e\u092f\u0915 \u0915\u0941\u0932\u0938\u091a\u093f\u0935,\u0935\u093f\u0924 \u0928\u093f\u092f\u0902\u0924\u094d\u0930\u0915, \u092e\u0939\u093e\u0930\u093e\u091c\u093e \u0917\u0902\u0917\u093e\u0938\u093f\u0902\u0939 \u0935\u093f\u0936\u094d\u0935\u0935\u093f\u0926\u094d\u092f\u093e\u0932\u092f, \u092c\u0940\u0915\u093e\u0928\u0947\u0930 |\n\u0938\u092e\u0938\u094d\u0924 \u0905\u0928\u0941\u092d\u093e\u0917 \u0905\u0927\u093f\u0915\u093e\u0930\u0940 (\u092a\u0930\u0940\u0915\u094d\u0937\u093e / \u0917\u094b\u092a\u0928\u0940\u092f / \u0928\u093e\u092e\u093e\u0902\u0915\u0928), \u092e\u0939\u093e\u0930\u093e\u091c\u093e \u0917\u0902\u0917\u093e\u0938\u093f\u0902\u0939 \u0935\u093f\u0936\u094d\u0935\u0935\u093f\u0926\u094d\u092f\u093e\u0932\u092f, \u092c\u0940\u0915\u093e\u0928\u0947\u0930 |\n\u092a\u094d\u0930\u093e\u091a\u093e\u0930\u094d\u092f, \u0938\u092e\u0938\u094d\u0924 \u0938\u0902\u092c\u0926\u094d\u0927 \u092e\u0939\u093e\u0935\u093f\u0926\u094d\u092f\u093e\u0932\u092f, \u092e\u0939\u093e\u0930\u093e\u091c\u093e \u0917\u0902\u0917\u093e\u0938\u093f\u0902\u0939 \u0935\u093f\u0936\u094d\u0935\u0935\u093f\u0926\u094d\u092f\u093e\u0932\u092f, \u092c\u0940\u0915\u093e\u0928\u0947\u0930 |\n\u0935\u093f\u092d\u093e\u0917\u093e\u0927\u094d\u092f\u0915\u094d\u0937, \u0938\u092e\u0938\u094d\u0924 \u0936\u0948\u0915\u094d\u0937\u093f\u0915 \u0935\u093f\u092d\u093e\u0917, \u092e\u0939\u093e\u0930\u093e\u091c\u093e \u0917\u0902\u0917\u093e\u0938\u093f\u0902\u0939 \u0935\u093f\u0936\u094d\u0935\u0935\u093f\u0926\u094d\u092f\u093e\u0932\u092f, \u092c\u0940\u0915\u093e\u0928\u0947\u0930 |\n\u0936\u094d\u0930\u0940 \u0915\u092e\u0932\u0915\u093e\u0902\u0924 \u0936\u0930\u094d\u092e\u093e, \u0928\u094b\u0921\u0932 \u0905\u0927\u093f\u0915\u093e\u0930\u0940, \u0935\u0947\u092c\u0938\u093e\u0908\u091f, \u092e\u0939\u093e\u0930\u093e\u091c\u093e \u0917\u0902\u0917\u093e\u0938\u093f\u0939 \u0935\u093f\u0936\u094d\u0935\u0935\u093f\u0926\u094d\u092f\u093e\u0932\u092f \u0915\u094b \u092a\u094d\u0930\u0947\u0937\u093f\u0924 \u0915\u0930 \u0932\u0947\u0916 \u0939\u0948 \u0915\u093f\n\u0909\u0915\u094d\u0924 \u0906\u0926\u0947\u0936 \u0935\u093f\u0936\u094d\u0935\u0935\u093f\u0926\u094d\u092f\u093e\u0932\u092f \u0935\u0947\u092c\u0938\u093e\u0908\u091f \u092a\u0930 \u0905\u092a\u0932\u094b\u0921 \u0915\u0930\u093e\u0935\u0947\u0902\u0964\n7. \u0924\u0915\u0928\u0940\u0915\u0940 \u092b\u0930\u094d\u092e \u0915\u094b \u092a\u094d\u0930\u0947\u0937\u093f\u0924 \u0915\u0930 \u0932\u0947\u0916 \u0939\u0948 \u0915\u093f \u092a\u0930\u0940\u0915\u094d\u0937\u093e \u092b\u0949\u0930\u094d\u092e \u092d\u0930\u093e\u0928\u0947 \u0938\u0902\u092c\u0902\u0927\u093f\u0924 \u0906\u0935\u0936\u094d\u092f\u0915 \u0915\u093e\u0930\u094d\u092f\u0935\u093e\u0939\u0940 \u0915\u0930\u0947\u0902\u0964\n\n\u0936\u0930\u094d\u0924 \u0939\u0930\u094d\u0937)\n\n\u091b\u0942 \u091b\u093e # \u096d\u0966 3\n\n(\u0921\u0949.\n\u0909\u092a\u0915\u0941\u0932\u0938\u091a\u093f\u0935-\u092a\u0930\u0940\u0915\u094d\u0937\u093e\n"}], "tables": [], "text": "ys MAHARAJA GANGA SINGH UNIVERSITY,BIKANER\nFORMERLY UNIVERSITY OF BIKANER, BIKANER\n\n\u0930\u093e\u0937\u094d\u091f\u094d\u0930\u0940\u092f \u0930\u093e\u091c\u092e\u093e\u0930\u094d\u0917 \u0938\u0902. 45, \u091c\u0948\u0938\u0932\u092e\u0947\u0930 \u0930\u094b\u0921\u093c, \u092c\u0940\u0915\u093e\u0928\u0947\u0930-334004 (\u0930\u093e\u091c\u0938\u094d\u0925\u093e\u0928) \u092d\u093e\u0930\u0924\n\nNATIONAL HIGHWAY NO. 5, JAISALMER ROAD, BIKANER-334004 (RAJASTHAN) INDIA\n\nas /Phone : 05-222044 baa/Fax : 22[2042 g-4e/E-mail : mgsubikaner@gmail.com _\n\n\u0915\u094d\u0930\u092e\u093e\u0902\u0915 : \u092a.45 ( )/\u092e\u0917\u0938\u093f\u0902\u0935\u093f\u092c\u0940/ We / 2026 / 255\u096b \u096f \u0926\u093f\u0928\u093e\u0902\u0915 A4-Of-202L\n\n\u0915\u093e\u0930\u094d\u092f\u093e\u0932\u092f \u0906\u0926\u0947\u0936\n\n\u092e\u093e\u0928\u0928\u0940\u092f \u0915\u0941\u0932\u0917\u0941\u0930\u0942 \u092e\u0939\u094b\u0926\u092f \u0926\u094d\u0935\u093e\u0930\u093e \u092a\u094d\u0930\u0926\u0924\u094d\u0924 \u0938\u094d\u0935\u0940\u0915\u0943\u0924\u093f \u0926\u093f\u0928\u093e\u0902\u0915 24.07.2026 \u0915\u0940 \u092a\u093e\u0932\u0928\u093e \u092e\u0947\u0902 \u0935\u093f\u0936\u094d\u0935\u0935\u093f\u0926\u094d\u092f\u093e\u0932\u092f \u0915\u0947\n\u0935\u093f\u092d\u093e\u0917\u094b\u0902 \u090f\u0935\u0902 \u0938\u0902\u092c\u0902\u0926\u094d\u0927\u0924\u093e \u092a\u094d\u0930\u093e\u092a\u094d\u0924 \u092e\u0939\u093e\u0935\u093f\u0926\u094d\u092f\u093e\u0932\u092f\u094b\u0902 \u092e\u0947\u0902 \u0938\u0902\u091a\u093e\u0932\u093f\u0924 \u0938\u094d\u0928\u093e\u0924\u0915 /\u0938\u094d\u0928\u093e\u0924\u0915\u094b\u0924\u094d\u0924\u0930 \u0938\u092e \u0938\u0947\u092e\u0947\u0938\u094d\u091f\u0930 \u091c\u0942\u0928 2026 \u0915\u0947 \u0932\u093f\u090f\n\u0906\u0935\u0947\u0926\u0928 \u092a\u0924\u094d\u0930 \u092d\u0930\u0928\u0947 \u0938\u0947 \u0935\u0902\u091a\u093f\u0924 \u0930\u0939\u0947 \u0935\u093f\u0926\u094d\u092f\u093e\u0930\u094d\u0925\u093f\u092f\u094b\u0902 \u0915\u094b \u0909\u0928\u0915\u0947 \u0905\u0928\u0941\u0930\u094b\u0927 \u0915\u0947 \u0906\u0927\u093e\u0930 \u092a\u0930 \u0924\u0940\u0928 \u0917\u0941\u0923\u093e \u0936\u0941\u0932\u094d\u0915 \u0915\u0947 \u0938\u093e\u0925 \u0906\u091c\n\u0926\u093f\u0928\u093e\u0902\u0915 24.07.2026 \u0915\u094b \u0905\u0902\u0924\u093f\u092e \u0905\u0935\u0938\u0930 \u092a\u094d\u0930\u0926\u093e\u0928 \u0915\u093f\u092f\u093e \u091c\u093e\u0924\u093e \u0939\u0948\u0964 \u0911\u0928\u0932\u093e\u0908\u0928 \u092a\u0930\u0940\u0915\u094d\u0937\u093e \u0906\u0935\u0947\u0926\u0928 \u092a\u0924\u094d\u0930 \u092d\u0930\u0928\u0947 \u0938\u092e\u094d\u092c\u0928\u094d\u0927\u0940 \u0926\u093f\u0936\u093e\n\u0928\u093f\u0930\u094d\u0926\u0947\u0936 \u0935\u093f\u0936\u094d\u0935\u0935\u093f\u0926\u094d\u092f\u093e\u0932\u092f \u0935\u0947\u092c\u0938\u093e\u0907\u091f \u092a\u0930 \u0909\u092a\u0932\u092c\u094d\u0927 \u0939\u0948\u0964\n\npyre\n(\u092a\u094d\u0930\u094b. \u0930\u093e\u091c\u093e\u0930\u093e\u092e \u091a\u094b\u092f\u0932)\n\u092a\u0930\u0940\u0915\u094d\u0937\u093e \u0928\u093f\u092f\u0902\u0924\u094d\u0930\u0915\n\n\u0915\u094d\u0930\u092e\u093e\u0902\u0915 : 045 ( ),/\u092e\u0917\u0938\u093f\u0902\u0935\u093f\u092c\u0940 / \u092a\u0930\u0940\u0915\u094d\u0937\u093e / 2026 / \u0926\u093f\u0928\u093e\u0902\u0915 :\n\u092a\u094d\u0930\u0924\u093f\u0932\u093f\u092a\u093f:- \u0928\u093f\u092e\u094d\u0928 \u0915\u094b \u0938\u0942\u091a\u0928\u093e\u0930\u094d\u0925 \u090f\u0935\u0902 \u0906\u0935\u0936\u094d\u092f\u0915 \u0915\u093e\u0930\u094d\u092f\u0935\u0939\u0940 \u0939\u0947\u0924\u0941 \u092a\u094d\u0930\u0947\u0937\u093f\u0924 \u0939\u0948\u0903-\n\n4. \u0928\u093f\u091c\u0940 \u0938\u091a\u093f\u0935 \u0915\u0941\u0932\u0917\u0941\u0930\u0942, \u092e\u0939\u093e\u0930\u093e\u091c\u093e \u0917\u0902\u0917\u093e\u0938\u093f\u0902\u0939 \u0935\u093f\u0936\u094d\u0935\u0935\u093f\u0926\u094d\u092f\u093e\u0932\u092f, \u092c\u0940\u0915\u093e\u0928\u0947\u0930 |\n\u0928\u093f\u091c\u0940 \u0938\u0939\u093e\u092f\u0915 \u0915\u0941\u0932\u0938\u091a\u093f\u0935,\u0935\u093f\u0924 \u0928\u093f\u092f\u0902\u0924\u094d\u0930\u0915, \u092e\u0939\u093e\u0930\u093e\u091c\u093e \u0917\u0902\u0917\u093e\u0938\u093f\u0902\u0939 \u0935\u093f\u0936\u094d\u0935\u0935\u093f\u0926\u094d\u092f\u093e\u0932\u092f, \u092c\u0940\u0915\u093e\u0928\u0947\u0930 |\n\u0938\u092e\u0938\u094d\u0924 \u0905\u0928\u0941\u092d\u093e\u0917 \u0905\u0927\u093f\u0915\u093e\u0930\u0940 (\u092a\u0930\u0940\u0915\u094d\u0937\u093e / \u0917\u094b\u092a\u0928\u0940\u092f / \u0928\u093e\u092e\u093e\u0902\u0915\u0928), \u092e\u0939\u093e\u0930\u093e\u091c\u093e \u0917\u0902\u0917\u093e\u0938\u093f\u0902\u0939 \u0935\u093f\u0936\u094d\u0935\u0935\u093f\u0926\u094d\u092f\u093e\u0932\u092f, \u092c\u0940\u0915\u093e\u0928\u0947\u0930 |\n\u092a\u094d\u0930\u093e\u091a\u093e\u0930\u094d\u092f, \u0938\u092e\u0938\u094d\u0924 \u0938\u0902\u092c\u0926\u094d\u0927 \u092e\u0939\u093e\u0935\u093f\u0926\u094d\u092f\u093e\u0932\u092f, \u092e\u0939\u093e\u0930\u093e\u091c\u093e \u0917\u0902\u0917\u093e\u0938\u093f\u0902\u0939 \u0935\u093f\u0936\u094d\u0935\u0935\u093f\u0926\u094d\u092f\u093e\u0932\u092f, \u092c\u0940\u0915\u093e\u0928\u0947\u0930 |\n\u0935\u093f\u092d\u093e\u0917\u093e\u0927\u094d\u092f\u0915\u094d\u0937, \u0938\u092e\u0938\u094d\u0924 \u0936\u0948\u0915\u094d\u0937\u093f\u0915 \u0935\u093f\u092d\u093e\u0917, \u092e\u0939\u093e\u0930\u093e\u091c\u093e \u0917\u0902\u0917\u093e\u0938\u093f\u0902\u0939 \u0935\u093f\u0936\u094d\u0935\u0935\u093f\u0926\u094d\u092f\u093e\u0932\u092f, \u092c\u0940\u0915\u093e\u0928\u0947\u0930 |\n\u0936\u094d\u0930\u0940 \u0915\u092e\u0932\u0915\u093e\u0902\u0924 \u0936\u0930\u094d\u092e\u093e, \u0928\u094b\u0921\u0932 \u0905\u0927\u093f\u0915\u093e\u0930\u0940, \u0935\u0947\u092c\u0938\u093e\u0908\u091f, \u092e\u0939\u093e\u0930\u093e\u091c\u093e \u0917\u0902\u0917\u093e\u0938\u093f\u0939 \u0935\u093f\u0936\u094d\u0935\u0935\u093f\u0926\u094d\u092f\u093e\u0932\u092f \u0915\u094b \u092a\u094d\u0930\u0947\u0937\u093f\u0924 \u0915\u0930 \u0932\u0947\u0916 \u0939\u0948 \u0915\u093f\n\u0909\u0915\u094d\u0924 \u0906\u0926\u0947\u0936 \u0935\u093f\u0936\u094d\u0935\u0935\u093f\u0926\u094d\u092f\u093e\u0932\u092f \u0935\u0947\u092c\u0938\u093e\u0908\u091f \u092a\u0930 \u0905\u092a\u0932\u094b\u0921 \u0915\u0930\u093e\u0935\u0947\u0902\u0964\n7. \u0924\u0915\u0928\u0940\u0915\u0940 \u092b\u0930\u094d\u092e \u0915\u094b \u092a\u094d\u0930\u0947\u0937\u093f\u0924 \u0915\u0930 \u0932\u0947\u0916 \u0939\u0948 \u0915\u093f \u092a\u0930\u0940\u0915\u094d\u0937\u093e \u092b\u0949\u0930\u094d\u092e \u092d\u0930\u093e\u0928\u0947 \u0938\u0902\u092c\u0902\u0927\u093f\u0924 \u0906\u0935\u0936\u094d\u092f\u0915 \u0915\u093e\u0930\u094d\u092f\u0935\u093e\u0939\u0940 \u0915\u0930\u0947\u0902\u0964\n\n\u0936\u0930\u094d\u0924 \u0939\u0930\u094d\u0937)\n\n\u091b\u0942 \u091b\u093e # \u096d\u0966 3\n\n(\u0921\u0949.\n\u0909\u092a\u0915\u0941\u0932\u0938\u091a\u093f\u0935-\u092a\u0930\u0940\u0915\u094d\u0937\u093e\n"}
